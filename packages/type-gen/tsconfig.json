{
  "extends": "@packages/tsconfig/tsconfig.lib-cjs.json",
  "compilerOptions": {
    "declaration": true,
    "lib": ["esnext", "DOM"],
    "newLine": "LF",
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "stripInternal": true,
    "outDir": "dist"
  },
  "include": ["src"]
}
