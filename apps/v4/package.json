{
  "name": "@apps/v4",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "copy-assets": "cp -r ../../packages/data/assets/images/. ./public/images/",
    "prebuild": "pnpm type-build-util && pnpm copy-assets",
    "build": "tsc -b && vite build",
    "build:dev": "tsc -b && vite build --mode development",
    "preview": "vite preview",
    "theme-typegen": "chakra typegen ./src/theme/index.ts"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.2.1",
    "@emotion/react": "^11.13.5",
    "@fontsource/pretendard": "^5.1.0",
    "jotai": "^2.10.3",
    "next-themes": "^0.4.3",
    "react": "^19",
    "react-dom": "^19",
    "react-grid-layout": "2.2.3",
    "react-icons": "^5.3.0",
    "react-router-dom": "^6.28.0",
    "@packages/data": "workspace:*"
  },
  "devDependencies": {
    "@chakra-ui/cli": "^3.2.1",
    "@originjs/vite-plugin-federation": "1.3.8",
    "@packages/shared": "workspace:*",
    "@packages/type-build-util": "workspace:*",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "sass": "^1.81.0",
    "typescript": "~5.6.2",
    "vite": "^8.0.0"
  }
}
