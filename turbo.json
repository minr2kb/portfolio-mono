{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "cache": false
    },
    "copy-assets": {
      "dependsOn": ["@packages/data#build"],
      "outputs": ["public/shared/**"],
      "cache": true
    },
    "dev": {
      "outputs": [],
      "persistent": true,
      "inputs": ["apps/**"]
    },
    "preview": {
      "outputs": [],
      "dependsOn": [],
      "persistent": true,
      "inputs": ["apps/**"]
    },
    "prebuild": {
      "outputs": [],
      "dependsOn": []
    },
    "build:dev": {
      "outputs": [],
      "dependsOn": [],
      "inputs": ["apps/**"],
      "cache": false
    }
  }
}
